# Copy to .env. Used by docker compose and by local scripts.
MYSQL_PASSWORD=change-me
# Local (non-docker) scripts connect through the published port:
DATABASE_URL=mysql+pymysql://f1:change-me@127.0.0.1:3307/f1opt
BUDGET_CAP=100
# Host ports for docker compose (the dashboard is at http://localhost:8501)
# API_PORT=8010
# DASHBOARD_PORT=8501
# Daily at 06:00 UTC
INGEST_CRON=0 6 * * *
# Set to 1 to store illustrative prices when no real prices exist for the next race
DEMO_PRICES=1
# Optional: your own Fantasy F1 session cookie to attempt real price collection (experimental)
# F1_FANTASY_COOKIE=
